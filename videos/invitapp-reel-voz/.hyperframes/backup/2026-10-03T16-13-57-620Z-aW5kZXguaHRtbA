    <script>
      // ElevenLabs word timings for assets/narracion.mp3: [text, start, end]
      const WORDS = [["Organizar", 0.0, 0.522], ["tu", 0.58, 0.662], ["boda", 0.685, 0.975], ["no", 1.045, 1.149], ["debería", 1.196, 1.544], ["ser", 1.591, 1.718], ["un", 1.776, 1.823], ["caos.", 1.869, 2.392], ["Con", 2.67, 2.856], ["InvitApp,", 2.926, 3.622], ["tus", 3.738, 3.901], ["invitados", 3.971, 4.447], ["confirman", 4.505, 5.074], ["desde", 5.143, 5.399], ["la", 5.457, 5.515], ["invitación,", 5.55, 6.235], ["en", 6.269, 6.339], ["un", 6.455, 6.525], ["toque.", 6.583, 7.129], ["Y", 7.454, 7.57], ["tú", 7.663, 7.767], ["ves", 7.825, 7.999], ["en", 8.069, 8.139], ["tiempo", 8.185, 8.499], ["real", 8.58, 8.882], ["quién", 8.998, 9.265], ["confirmó,", 9.311, 10.043], ["quién", 10.368, 10.565], ["está", 10.612, 10.786], ["pendiente", 10.855, 11.447], ["y", 11.529, 11.575], ["cuántas", 11.691, 12.086], ["personas", 12.144, 12.608], ["van.", 12.666, 13.131], ["Después", 13.642, 14.222], ["armas", 14.303, 14.594], ["tus", 14.652, 14.791], ["mesas:", 14.861, 15.43], ["eliges", 15.755, 16.173], ["al", 16.243, 16.301], ["invitado,", 16.359, 17.114], ["tocas", 17.23, 17.601], ["la", 17.671, 17.752], ["mesa,", 17.822, 18.356], ["y", 18.739, 18.82], ["listo.", 18.901, 19.459], ["Sin", 19.842, 20.074], ["pasarte", 20.121, 20.562], ["del", 20.608, 20.724], ["cupo.", 20.794, 21.398], ["InvitApp.", 21.723, 22.675], ["Invitaciones", 22.919, 23.731], ["que", 23.824, 23.929], ["enamoran,", 23.998, 24.857], ["y", 25.032, 25.101], ["una", 25.217, 25.345], ["fiesta", 25.415, 25.821], ["bajo", 25.879, 26.169], ["control.", 26.216, 26.959], ["Escríbenos.", 27.284, 28.7]];
      // caption chunks, as word counts in reading order (last 10 words are the close)
      const CHUNKS = [8, 5, 6, 8, 7, 4, 8, 4];

      const tl = gsap.timeline({ paused: true });
      const at = (word, nth = 1) => {
        let seen = 0;
        for (const [t, s] of WORDS) if (t.replace(/[.,:]/g, "") === word && ++seen === nth) return s;
        throw new Error("word not found: " + word);
      };

      // ground drift
      tl.fromTo("#ring-1", { scale: 0.92, rotation: 0 }, { scale: 1.06, rotation: 14, duration: 30, ease: "none" }, 0);
      tl.fromTo("#ring-2", { scale: 1, y: 0 }, { scale: 1.12, y: -60, duration: 30, ease: "none" }, 0);

      // ---------- captions ----------
      const capRoot = document.getElementById("captions");
      let wi = 0;
      const chunkStarts = CHUNKS.map((n) => {
        const s = WORDS[wi][1];
        wi += n;
        return s;
      });
      wi = 0;
      CHUNKS.forEach((n, ci) => {
        const box = document.createElement("div");
        box.className = "cap";
        box.id = "cap-" + ci;
        const words = WORDS.slice(wi, wi + n);
        words.forEach(([t], k) => {
          const sp = document.createElement("span");
          sp.className = "w";
          sp.id = `cap-${ci}-${k}`;
          sp.textContent = t;
          box.appendChild(sp);
        });
        capRoot.appendChild(box);
        const start = Math.max(0, chunkStarts[ci] - 0.08);
        const end = ci + 1 < CHUNKS.length ? chunkStarts[ci + 1] - 0.1 : 21.55;
        tl.fromTo(box, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.22, ease: "power2.out" }, start);
        tl.to(box, { opacity: 0, duration: 0.15, ease: "power1.in" }, end - 0.15);
        words.forEach(([, s], k) => {
          tl.fromTo(`#cap-${ci}-${k}`, { opacity: 0.22 }, { opacity: 1, duration: 0.12, ease: "none" }, s);
        });
        wi += n;
      });

      // ---------- 01 — chaos ----------
      const notes = ["#n1", "#n2", "#n3", "#n4", "#n5"];
      const tilts = [-7, 6, -4, 8, -6];
      notes.forEach((n, i) => {
        tl.fromTo(n, { opacity: 0, scale: 0.7, rotation: 0 }, { opacity: 1, scale: 1, rotation: tilts[i], duration: 0.45, ease: "back.out(1.8)" }, 0.1 + i * 0.28);
        tl.fromTo(`${n} .note-card`, { x: 0 }, { x: 10, duration: 0.06, ease: "none", repeat: 5, yoyo: true }, at("caos") + i * 0.02);
        tl.to(n, { opacity: 0, y: 200, rotation: tilts[i] * 3, duration: 0.4, ease: "power2.in", immediateRender: false }, 2.45 + i * 0.03);
      });

      // ---------- 02 — the guest confirms ----------
      tl.fromTo("#phone", { opacity: 0, y: 220 }, { opacity: 1, y: 0, duration: 0.8, ease: "expo.out" }, 2.55);
      const showScreen = (id, t, fromY = 40) =>
        tl.fromTo(id, { opacity: 0, y: fromY }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" }, t);
      const tap = (id, t) => {
        tl.fromTo(id, { opacity: 0, scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.18, ease: "power2.out" }, t);
        tl.to(id, { opacity: 0, scale: 1.6, duration: 0.4, ease: "power1.out" }, t + 0.22);
      };
      tl.set("#sc-inv", { opacity: 1 }, 0);
      tl.fromTo("#sc-inv", { scale: 1.06 }, { scale: 1, duration: 1.4, ease: "power2.out" }, 2.6);
      showScreen("#sc-rsvp", at("tus"));
      tap("#tap-1", at("confirman") + 0.1);
      showScreen("#sc-form", at("desde"));
      tap("#tap-2", at("toque") - 0.05);
      tl.fromTo("#chip-rsvp", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, at("toque") + 0.15);
      tl.to("#chip-rsvp", { opacity: 0, duration: 0.25 }, at("Y") - 0.2);

      // ---------- 03 — the couple's dashboard ----------
      showScreen("#sc-panel", at("Y") - 0.05);
      const chipIn = (id, t, fromX) =>
        tl.fromTo(id, { opacity: 0, x: fromX }, { opacity: 1, x: 0, duration: 0.45, ease: "back.out(1.6)" }, t);
      chipIn("#chip-ok", at("confirmó"), -60);
      chipIn("#chip-wait", at("pendiente"), 60);
      chipIn("#chip-people", at("personas"), -60);
      showScreen("#sc-list", at("van") + 0.1, 120);
      tl.to(["#chip-ok", "#chip-wait", "#chip-people"], { opacity: 0, duration: 0.3 }, at("Después") - 0.15);

      // ---------- 04 — seating ----------
      showScreen("#sc-mesas", at("Después"));
      showScreen("#sc-sel", at("eliges"));
      tl.fromTo("#hl-sel", { opacity: 0 }, { opacity: 1, duration: 0.25 }, at("invitado"));
      tl.to("#hl-sel", { opacity: 0, duration: 0.2 }, at("tocas") + 0.3);
      tap("#tap-3", at("tocas") + 0.15);
      showScreen("#sc-seat", at("listo") - 0.1, 0);
      tl.fromTo("#hl-mesa", { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.3, ease: "power2.out" }, at("listo"));
      tl.fromTo("#chip-cupo", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, at("Sin"));
