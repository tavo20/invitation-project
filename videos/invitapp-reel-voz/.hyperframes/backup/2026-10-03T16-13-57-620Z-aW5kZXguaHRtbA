<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @font-face {
        font-family: "Great Vibes";
        src: url("assets/fonts/great-vibes.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
      }
      @font-face {
        font-family: "Cormorant Garamond";
        src: url("assets/fonts/cormorant.woff2") format("woff2");
        font-weight: 300 700;
        font-style: normal;
      }
      @font-face {
        font-family: "Cormorant Garamond";
        src: url("assets/fonts/cormorant-italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
      }
      :root {
        --canvas: #faf8f5;
        --ink: #222222;
        --accent: #a38c7b;
        --accent-ink: #7a6657;
        --muted: #6b625b;
        --ok: #2f7d4f;
        --wait: #a86b12;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: var(--canvas);
      }
      #root {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: var(--canvas);
        font-family: "Cormorant Garamond", serif;
        color: var(--ink);
      }
      .layer {
        position: absolute;
        inset: 0;
      }
      .script {
        font-family: "Great Vibes", cursive;
        font-weight: 400;
      }

      /* ground */
      #bg {
        background: radial-gradient(circle at 50% 46%, #f1ebe4 0%, var(--canvas) 62%);
      }
      .bg-ring {
        position: absolute;
        border: 1.5px solid rgba(163, 140, 123, 0.26);
        border-radius: 50%;
      }

      /* captions */
      #captions {
        position: absolute;
        left: 70px;
        right: 70px;
        top: 236px;
        height: 230px;
      }
      .cap {
        position: absolute;
        inset: 0;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        justify-content: center;
        gap: 0 16px;
        text-align: center;
        font-size: 66px;
        line-height: 1.12;
        font-weight: 600;
        color: var(--ink);
      }
      .cap .w {
        display: inline-block;
      }

      /* 01 chaos */
      .note {
        position: absolute;
        width: 420px;
      }
      .note-card {
        background: #fff;
        border: 1.5px solid rgba(163, 140, 123, 0.35);
        border-radius: 22px;
        padding: 26px 30px;
        font-size: 40px;
        font-weight: 600;
        color: var(--ink);
        box-shadow: 0 18px 40px -22px rgba(60, 40, 25, 0.45);
      }
      .note-card small {
        display: block;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent-ink);
        margin-bottom: 6px;
      }

      /* phone */
      #phone {
        position: absolute;
        left: 291px;
        top: 520px;
        width: 498px;
        height: 1045px;
        background: #151515;
        border-radius: 66px;
        padding: 14px;
        box-shadow:
          0 50px 90px -34px rgba(60, 40, 25, 0.5),
          0 14px 34px -14px rgba(60, 40, 25, 0.32);
      }
      #screen {
        position: relative;
        width: 470px;
        height: 1017px;
        border-radius: 54px;
        overflow: hidden;
        background: #0f1626;
      }
      #screen img {
        position: absolute;
        left: 0;
        top: 0;
        width: 470px;
        height: 1017px;
      }
      #notch {
        position: absolute;
        top: 26px;
        left: 50%;
        width: 110px;
        height: 30px;
        margin-left: -55px;
        border-radius: 16px;
        background: #151515;
      }
      .tap {
        position: absolute;
        width: 96px;
        height: 96px;
        margin: -48px 0 0 -48px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 0 0 6px rgba(163, 140, 123, 0.45);
      }
      .hl {
        position: absolute;
        border: 4px solid #e8c47a;
        border-radius: 14px;
        box-shadow: 0 0 24px rgba(232, 196, 122, 0.55);
      }

      /* chips */
      .chip {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 30px;
        border-radius: 999px;
        background: #fff;
        font-size: 40px;
        font-weight: 700;
        color: var(--ink);
        box-shadow: 0 20px 44px -20px rgba(60, 40, 25, 0.5);
        border: 1.5px solid rgba(163, 140, 123, 0.3);
        white-space: nowrap;
      }
      .dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        flex: none;
      }
      .chip svg {
        width: 38px;
        height: 38px;
        flex: none;
        display: block;
      }

      /* close */
      #close-panel {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 42%, #34302c 0%, #1c1a18 72%);
      }
      .close-wrap {
        position: absolute;
        left: 0;
        right: 0;
        top: 560px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        color: #fbf6f0;
      }
      #c-kicker {
        font-size: 30px;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: #c9b4a3;
        font-weight: 600;
      }
      #c-brand {
        display: block;
        font-size: 250px;
        line-height: 1.05;
        margin-top: 50px;
      }
      #c-rule {
        width: 180px;
        height: 2px;
        background: #c9b4a3;
        margin: 26px 0 44px;
      }
      #c-tag {
        width: 860px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0 14px;
        font-size: 62px;
        line-height: 1.22;
        font-style: italic;
        color: #e9dfd5;
      }
      #c-tag .w {
        display: inline-block;
      }
      .c-row {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 26px;
        margin-top: 90px;
      }
      #c-price {
        padding: 22px 56px;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-size: 50px;
        font-weight: 700;
      }
      #c-wa {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 48px;
        border-radius: 999px;
        border: 2px solid #c9b4a3;
        font-size: 50px;
        font-weight: 600;
      }
      #c-wa svg {
        width: 48px;
        height: 48px;
        display: block;
      }
    </style>
  </head>
